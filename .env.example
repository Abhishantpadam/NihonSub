# Server Port
PORT=3000

# Groq API Key (Required for Whisper Large-v3 Speech-to-Text & Default Translation)
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Key (Optional: Auto-fallback when Groq hits 429 rate limit)
# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Optional: Custom path to FFmpeg / FFprobe if not in standard system PATH
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# FFPROBE_PATH=/opt/homebrew/bin/ffprobe
